# PUSD frontend environment
# Copy to .env.local for local development. Never commit real secrets.

# Backend base URL (no trailing slash). Used by the same-origin /api proxies.
NEXT_PUBLIC_SERVER_URL=http://localhost:8001

# Direct backend API URL. Leave unset to use the same-origin /api proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Pi network: "testnet" enables the Pi sandbox SDK and the testnet Platform API.
NEXT_PUBLIC_NETWORK=testnet
# NEXT_PUBLIC_PI_SANDBOX=true

# Pi OAuth sign-in (Pi Sign-In). Register <origin>/signin/callback as an
# allowed redirect URI for this client id in the Pi Developer Portal.
NEXT_PUBLIC_PI_SIGNIN_CLIENT_ID=D4J78fR00oCu6NsB7zTxNLXKuifkanU-J_6pZ5g1lPs

# Testnet USD asset code used by the test-mode UI.
NEXT_PUBLIC_USD_TEST_ASSET_CODE=USDTEST
